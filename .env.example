# Plantilla de variables de entorno — copiar a .env.local para desarrollo,
# o cargar en Vercel → Settings → Environment Variables (Production + Preview).
#
# .env y .env.local están en .gitignore: nunca commitear valores reales.

# ── Server-side (Vercel Functions). NUNCA con prefijo VITE_ ──────────────────
# El prefijo VITE_ mete la variable en el bundle de JavaScript que sirve el
# navegador. Para una clave secreta, eso es publicarla.

# Clasificación y enriquecimiento con Groq, y modo rápido del OCR de fotos
GROQ_API_KEY=

# OCR de las fotos de placas (proveedor por defecto).
# Sacarla de https://aistudio.google.com/apikey, del proyecto de Google Cloud
# que tiene el PLAN PAGO: una key del tier gratis trae menos cupo y la cláusula
# de que Google usa el contenido para entrenar.
GEMINI_API_KEY=

SUPABASE_URL=
SUPABASE_KEY=

# ── Frontend (Vite). Estas SÍ llegan al browser, a propósito ─────────────────
# Existen solo para que el celular suba las fotos directo a Supabase Storage y
# esquive el límite de ~4.5MB de body de las Vercel Functions. Son los mismos
# valores que SUPABASE_URL y SUPABASE_KEY: la anon key es pública por diseño y
# la seguridad la da la policy del bucket, no el secreto de la key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
